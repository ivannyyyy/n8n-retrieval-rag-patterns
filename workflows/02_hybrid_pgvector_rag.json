    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH q AS (\n    SELECT plainto_tsquery('russian', $1) AS query\n)\nSELECT\n    hk.id,\n    hk.text AS \"pageContent\",\n    hk.metadata,\n    ts_rank_cd(\n        to_tsvector('russian', hk.text),\n        q.query\n    ) AS fts_score\nFROM retrieval_demo.knowledge_base hk\nCROSS JOIN q\nWHERE\n    to_tsvector('russian', hk.text) @@ q.query\nORDER BY fts_score DESC\nLIMIT 10;",
        "options": {
          "queryReplacement": "={{ $json.chatInput }}"
        }
