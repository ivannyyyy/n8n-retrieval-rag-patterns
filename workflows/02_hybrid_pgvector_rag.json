        "query": "SELECT\n    EXISTS (\n        SELECT 1\n        FROM retrieval_demo.knowledge_base\n        WHERE metadata->>'document_key' = $1\n    ) AS document_exists,\n\n    EXISTS (\n        SELECT 1\n        FROM retrieval_demo.knowledge_base\n        WHERE metadata->>'document_key' = $1\n          AND metadata->>'file_unique_id' = $2\n    ) AS exact_file_exists,\n\n    (\n        SELECT COUNT(*)\n        FROM retrieval_demo.knowledge_base\n        WHERE metadata->>'document_key' = $1\n    ) AS chunks_count;",
        "options": {
