        "nodeCredentialType": "cohereApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"rerank-v3.5\",\n  \"query\": $('When chat message received').item.json.chatInput,\n  \"documents\": $json.candidates.map(x => x.pageContent),\n  \"top_n\": 3\n} }}",
