      "id": "3e620c71-5b23-43af-a832-8676164edf0b",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const candidates = $('Aggregate').first().json.candidates;\nconst results = $input.first().json.results;\n\nreturn results.map(result => ({\n  json: {\n    ...candidates[result.index],\n    relevance_score: result.relevance_score,\n    rerank_index: result.index\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        704
      ],
      "id": "0589356f-92dc-4c34-a401-e2d354c0766a",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const docs = $input.all().map(item => item.json);\n\nconst context = docs.map((doc, i) => {\n  return `\n[Источник ${i + 1}]\nФайл: ${doc.metadata?.source ?? 'неизвестно'}\nСтраница: ${doc.metadata?.page ?? 'неизвестно'}\nТекст:\n${doc.pageContent}\n`.trim();\n}).join('\\n\\n');\n\nreturn [{\n  json: {\n    question: $('When chat message received').first().json.chatInput,\n    context\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
